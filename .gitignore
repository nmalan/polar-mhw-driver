# Data — never commit NetCDF/Zarr to git
*.nc
*.zarr
*.h5
*.hdf5

# Figures — plots/ IS tracked, so the full-resolution figures written on Gadi come
# back to the laptop on a pull. The notebooks also embed lower-resolution copies as
# cell outputs, and those are what GitHub renders inline; plots/ holds the version to
# actually use in the chapter. Note that every committed regeneration stays in history
# permanently, so commit figures when they are worth keeping, not on every run.
figures/

# OS
.DS_Store
